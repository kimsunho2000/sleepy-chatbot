OPENAI_API_KEY=

# Supabase PostgreSQL: 서버 전용 연결 문자열. 실제 비밀번호는 .env에만 둡니다.
# 로컬 개발(backend/compose.yaml): postgresql://sleeby:sleeby@localhost:5433/sleeby
DATABASE_URL=

# 관리자 계정 1개 (환경변수로만 관리)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=관리자
# 관리자 토큰 서명 비밀값 (32자 이상). 바꾸면 발급된 관리자 토큰이 모두 무효가 됩니다
ADMIN_TOKEN_SECRET=

# 클라이언트 IP를 해시로 저장할 때 쓰는 비밀값 (16자 이상)
IP_HASH_SECRET=

# CORS 허용 도메인 (챗봇 프론트, 관리자 프론트). JSON 배열
CORS_ORIGINS=["http://localhost:5173","http://localhost:5175"]

# 앞단 프록시 수. 0이면 X-Forwarded-For를 무시합니다 (Cloud Run 직접 연결은 1)
TRUSTED_PROXY_COUNT=0
